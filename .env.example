# ==============================================================================
# WORK-LIFE HUB - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your actual values.
# Do NOT commit .env.local or any real secrets to Git.

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required for Auth & Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Optional fallback if using publishable key naming
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"

# ------------------------------------------------------------------------------
# 2. S3 / Backblaze B2 Object Storage (Attachments & File Uploads)
# ------------------------------------------------------------------------------
S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
S3_REGION="us-east-005"
S3_ACCESS_KEY_ID="your-b2-or-s3-key-id"
S3_SECRET_ACCESS_KEY="your-b2-or-s3-secret-key"
S3_BUCKET_NAME="your-bucket-name"
# Optional public CDN / friendly URL prefix (if bucket is public or behind Cloudflare/CDN)
# S3_PUBLIC_URL_PREFIX="https://your-custom-cdn.domain.com"

# ------------------------------------------------------------------------------
# 3. Email Notifications (Resend - Optional)
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_123456789"
# RESEND_FROM_EMAIL="Hub Notifications <notifications@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. GitHub Integration (Optional - for Repository & Issue Sync)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN="ghp_your_github_personal_access_token"

# ------------------------------------------------------------------------------
# 5. Scheduled Tasks & Cron Secret (Optional)
# ------------------------------------------------------------------------------
# CRON_SECRET="your-cron-auth-secret-key"

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres?sslmode=require

